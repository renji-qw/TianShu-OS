# 天枢 OS — 轻量版内存看门狗（root）。是否真正生效由 /etc/tianshu/memguard.conf 决定。
[Unit]
Description=TianShu Memguard (memory watchdog)
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/tianshu-memguard watchdog
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
