[Compositing]
AnimationSpeed=1
Backend=OpenGL
Enabled=true
GraphicsSystem=OpenGL
LatencyPolicy=ForceLowest
OpenGLIsUnsafe=false
AllowTearing=false
MaxFPS=60
RefreshRate=60
XRenderSmoothScale=true
HiddenPreviews=5

[Effect-blur]
BlurStrength=12
NoiseStrength=2
blurStrength=12

[Effect-rounded-corners]
Radius=12
Size=12
OutlineThickness=0

[Effect-kwin4_effect_shapecorners]
Roundness=12
Size=12
OutlineThickness=0

[Plugins]
blurEnabled=true
rounded-cornersEnabled=true
kwin4_effect_shapecornersEnabled=true
slideEnabled=true
fadeEnabled=true
scaleEnabled=true
wobblywindowsEnabled=false
magiclampEnabled=false
diminactiveEnabled=true

[Windows]
BorderlessMaximizedWindows=false
FocusPolicy=ClickToFocus
Placement=Centered
SnapOnlyWhenTouching=false
ElectricBorderMaximize=true

[org.kde.kdecoration2]
BorderSize=None
ButtonsOnLeft=MF
ButtonsOnRight=IAX
library=org.kde.breeze
NoSideBorderShadows=true

[TabBox]
LayoutName=thumbnail
