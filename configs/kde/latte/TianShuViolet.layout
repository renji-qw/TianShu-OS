{
    "version": 2,
    "name": "TianShu Violet Dock",
    "schema": "https://raw.githubusercontent.com/KDE/latte-dock/master/data/layouts/org.kde.latte.default.layout",
    "containments": [
        {
            "index": 0,
            "type": "dock",
            "alignment": "center",
            "iconSize": 36,
            "maxLength": 640,
            "minLength": 320,
            "offset": 0,
            "position": "bottom",
            "floating": true,
            "floatingGap": 8,
            "hideMode": "dodge-maximized",
            "lengthMode": "fit-content",
            "alignmentEdgeDistances": [12, 12],
            "backgroundOnlyWindow": true,
            "theme": "Edna",
            "applets": [
                { "plugin": "org.kde.plasma.kickoff" },
                { "plugin": "org.kde.plasma.icon" },
                { "plugin": "org.kde.plasma.icontasks" },
                { "plugin": "org.kde.plasma.marginsseparator" },
                { "plugin": "org.kde.plasma.systemtray" }
            ]
        }
    ],
    "applets": []
}
