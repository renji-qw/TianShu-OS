# tianshu_core v2.0.0-debian-alpha —— 用户态 systemd 单元
#
# 机制：systemd --user 在用户首次登录时启动并管理用户服务，登出即终止；
#       配合 loginctl enable-linger <user>（由 tianshu-linger.service 开启），
#       未登录时用户实例也能存活。

[Unit]
Description=TianShu Core
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/tianshu_core

# 2G 硬开关与内存看门狗的判定逻辑在 memguard 内部，单元内不写死阈值
ExecStartPost=/usr/local/bin/tianshu-memguard session

Restart=on-failure
RestartSec=5

# 内存上限：核心常驻，512M 足够
MemoryHigh=256M
MemoryMax=512M

# 日志环境
Environment=RUST_LOG=info
Environment=TIANSHU_RESERVE_MB=64

# 捕获 SIGINT 以执行优雅退出
KillSignal=SIGINT

# 进程被清理时只杀主进程
KillMode=process

# 防爆核心转储文件
LimitCORE=0

# 权限最小化加固
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=graphical-session.target
