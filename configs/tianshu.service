# tianshu_core v1.0.1-beta systemd unit

[Unit]
Description=TianShu OS Core Engine
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root

# 调度核心的绝对路径
ExecStart=/usr/bin/tianshu_core

# 崩溃 3 秒后自动拉起，防无限刷屏
Restart=always
RestartSec=3

# 捕获 SIGINT 以执行优雅退出
KillSignal=SIGINT

# 日志环境
Environment=RUST_LOG=info
Environment=TIANSHU_RESERVE_MB=64

# 赋予极高的 CPU 优先级，防止系统满载时调度器被饿死
Nice=-10

# 解除物理内存锁定限制
LimitMEMLOCK=infinity

# 防爆核心转储文件
LimitCORE=0

# 限制最大内存占用（防泄漏，已放宽至 2G 以适应高预留场景）
MemoryMax=2G

# 进程被清理时只杀主进程
KillMode=process

# 权限最小化加固
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
